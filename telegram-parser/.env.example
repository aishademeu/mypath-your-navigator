# Telegram MTProto Credentials
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# PostHog AI Observability (public project token and ingestion host)
POSTHOG_PROJECT_TOKEN=your_posthog_project_token
POSTHOG_HOST=your_posthog_host

# Supabase Credentials (from MyPath)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_publishable_key_here

# Channels to monitor (usernames without @, comma-separated)
CHANNELS=edu_strategies,deeppurplehub,asselibadulla
